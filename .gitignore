# ---- Unity (unity/ project) ----
unity/[Ll]ibrary/
unity/[Tt]emp/
unity/[Oo]bj/
unity/[Bb]uild/
unity/[Bb]uilds/
unity/[Ll]ogs/
unity/[Uu]ser[Ss]ettings/
unity/[Mm]emoryCaptures/
unity/[Rr]ecordings/

# Never ignore meta files (required for team collaboration in git)
!unity/**/*.meta

# Autogenerated VS/Rider/VSCode project files
unity/.vs/
unity/.vsconfig
unity/*.csproj
unity/*.unityproj
unity/*.sln
unity/*.suo
unity/*.tmp
unity/*.user
unity/*.userprefs
unity/*.pidb
unity/*.booproj
unity/*.svd
unity/*.pdb
unity/*.mdb
unity/*.opendb
unity/*.VC.db
unity/.idea/

# Unity3D generated crash/asset files
unity/sysinfo.txt
unity/*.stackdump

# Builds
unity/*.apk
unity/*.aab
unity/*.unitypackage
unity/*.app
unity/*.exe
unity/WebGL-Build/

# Crashlytics generated file
unity/crashlytics-build.properties

# Raw system font copy used once to bake the TMP SDF atlas (Fonts/UIFont SDF.asset,
# see Assets/Editor/TmpFontBuilder.cs) — not ours to redistribute, only the derived
# rasterized atlas ships in the repo/build.
unity/Assets/Fonts/_SourceOnly/
unity/Assets/Fonts/_SourceOnly.meta

# Local addressables/asset bundle caches
unity/[Aa]ssets/AddressableAssetsData/*/*.bin*
unity/[Aa]ssets/StreamingAssets/aa.meta
unity/[Aa]ssets/StreamingAssets/aa/*

# Claude Code session runtime state
.claude/scheduled_tasks.lock

# OS / editor junk
.DS_Store
Thumbs.db
*.swp
